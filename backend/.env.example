ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://uk:uk@localhost:5432/uk
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-dev-secret-key-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# Опрос внешних систем учёта показаний
METER_SYNC_ENABLED=true
METER_SYNC_INTERVAL_MINUTES=30

# Реквизиты УК (печатаются в квитанции и QR-коде для оплаты)
COMPANY_NAME=ООО "УК Пример"
COMPANY_INN=7700000000
COMPANY_KPP=770001001
COMPANY_BANK_NAME=ПАО "Сбербанк"
COMPANY_BIK=044525225
COMPANY_BANK_ACCOUNT=40702810000000000000
COMPANY_CORR_ACCOUNT=30101810400000000225
COMPANY_ADDRESS=г. Москва, ул. Примерная, д. 1
COMPANY_PHONE=+7 (495) 000-00-00
