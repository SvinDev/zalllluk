# Скопируйте в .env и поменяйте значения перед запуском: cp .env.example .env
ENVIRONMENT=production
# openssl rand -base64 48   (в Codespaces .env создаётся автоматически)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
TIMEZONE=Europe/Moscow

POSTGRES_USER=uk
POSTGRES_PASSWORD=uk
POSTGRES_DB=uk

METER_SYNC_ENABLED=true
METER_SYNC_INTERVAL_MINUTES=30

# Реквизиты УК для квитанций и QR-кода оплаты
COMPANY_NAME=ООО "УК Пример"
COMPANY_INN=7700000000
COMPANY_KPP=770001001
COMPANY_BANK_NAME=ПАО "Сбербанк"
COMPANY_BIK=044525225
COMPANY_BANK_ACCOUNT=40702810000000000000
COMPANY_CORR_ACCOUNT=30101810400000000225
COMPANY_ADDRESS=г. Москва, ул. Примерная, д. 1
COMPANY_PHONE=+7 (495) 000-00-00
